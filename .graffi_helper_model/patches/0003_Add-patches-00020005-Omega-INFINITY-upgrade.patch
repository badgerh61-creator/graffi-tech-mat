++"""
++Simple revocation-check service stub.
++Checks local ledger and optionally remote revocation list for a patch.
++"""
++import sqlite3
++from typing import Optional
++
++LEDGER_DB = "ledger/ledger.db"
++
++def is_revoked(patch_hash: str) -> bool:
++    con = sqlite3.connect(LEDGER_DB)
++    cur = con.cursor()
++    cur.execute("SELECT status FROM patch_ledger WHERE patch_hash = ?", (patch_hash,))
++    row = cur.fetchone()
++    con.close()
++    if not row:
++        return False
++    return row[0] == "revoked"
++
++def mark_revoked(patch_hash: str, reason: Optional[str] = None):
++    con = sqlite3.connect(LEDGER_DB)
++    cur = con.cursor()
++    cur.execute("UPDATE patch_ledger SET status = 'revoked' WHERE patch_hash = ?", (patch_hash,))
++    con.commit()
++    con.close()
+
