++"""
++Patch Manifest generator
++ - Scans patches directory
++ - Verifies signatures / computes quantum checksums
++ - Writes manifest JSON (used by auto-rebuilder)
++"""
++import os, json, time
++from graffi.quantum_checksum import multi_hash
++from graffi.patch_signer import verify_file
++
++PATCH_DIR = ".graffi_helper_model/patches"
++MANIFEST = ".graffi_helper_model/patch_manifest.json"
++
++def build_manifest():
++    patches = []
++    if not os.path.isdir(PATCH_DIR):
++        return {}
++    for p in sorted(os.listdir(PATCH_DIR)):
++        if not p.endswith(".patch"):
++            continue
++        path = os.path.join(PATCH_DIR, p)
++        ok = verify_file(path)
++        chk = multi_hash(path)
++        patches.append({
++            "file": p,
++            "path": path,
++            "verified_signature": bool(ok),
++            "fingerprint": chk["fingerprint"],
++            "meta": chk["meta"],
++            "timestamp": int(time.time())
++        })
++    out = {"generated": int(time.time()), "patches": patches}
++    os.makedirs(os.path.dirname(MANIFEST), exist_ok=True)
++    with open(MANIFEST, "w") as f:
++        json.dump(out, f, indent=2)
++    return out
++
++if __name__ == "__main__":
++    print("manifest:", build_manifest())
+
