+"""
+Small inference API (file-based) to load a registered model and run predictions.
+"""
+from ml.trainer import SimpleLogistic
+from ml.registry import get_latest_by_name
+from typing import List
+
+def predict_for_features(model_name: str, feature_vectors: List[List[float]]):
+    model_meta = get_latest_by_name(model_name)
+    if not model_meta:
+        raise RuntimeError("model not found")
+    model = SimpleLogistic.load(model_name)
+    preds = [model.predict_proba(x) for x in feature_vectors]
+    return preds
+
+if __name__ == "__main__":
+    # demo
+    mm = get_latest_by_name("demo_model")
+    if not mm:
+        print("no demo model; skip")
+    else:
+        print(predict_for_features("demo_model", [[1,20,1],[12,5,0]]))

