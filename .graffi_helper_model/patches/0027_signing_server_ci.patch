diff --git a/.github/workflows/signing_server.yml b/.github/workflows/signing_server.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/signing_server.yml
@@ -0,0 +1,160 @@
+name: Signing Server CI
+
+on:
+  push:
+    paths:
+      - 'signing_server/**'
+  pull_request:
+    paths:
+      - 'signing_server/**'
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Set up Python
+        uses: actions/setup-python@v4
+        with:
+          python-version: "3.10"
+      - name: Install deps
+        run: |
+          python -m pip install --upgrade pip
+          pip install fastapi uvicorn requests
+      - name: Lint & quick start test
+        run: |
+          # basic import smoke test
+          python -c "import signing_server.app; print('import ok')"
+      - name: Start server & healthcheck
+        run: |
+          nohup uvicorn signing_server.app:app --host 127.0.0.1 --port 9001 &>/dev/null &
+          sleep 1
+          curl -sS http://127.0.0.1:9001/api/v1/pubkey || (cat nohup.out && exit 1)

