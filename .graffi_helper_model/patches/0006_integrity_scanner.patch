+"""
+Graffi Integrity Scanner (Omega-INFINITY Tier)
+----------------------------------------------
+Performs SHA-256 checks over core system files and patch chain.
+Detects corruption, mismatched patches, or unauthorized changes.
+"""
+
+import os, hashlib, json
+
+CORE_FILES = [
+    "graffi_helper.py",
+    "graffi/updater.py",
+    "auto_rebuilder.sh",
+    "apply_patch_series.sh"
+]
+
+def sha256(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for block in iter(lambda: f.read(4096), b""):
+            h.update(block)
+    return h.hexdigest()
+
+def scan():
+    report = {}
+    for file in CORE_FILES:
+        if os.path.exists(file):
+            report[file] = sha256(file)
+        else:
+            report[file] = "MISSING"
+
+    patch_hashes = {}
+    patch_dir = ".graffi_helper_model/patches"
+    if os.path.isdir(patch_dir):
+        for p in sorted(os.listdir(patch_dir)):
+            full = os.path.join(patch_dir, p)
+            patch_hashes[p] = sha256(full)
+
+    return {
+        "core": report,
+        "patches": patch_hashes
+    }
+
+def write_report(path="graffi_integrity.json"):
+    data = scan()
+    with open(path, "w") as f:
+        json.dump(data, f, indent=4)
+    return path
+
+if __name__ == "__main__":
+    print(json.dumps(scan(), indent=4))

