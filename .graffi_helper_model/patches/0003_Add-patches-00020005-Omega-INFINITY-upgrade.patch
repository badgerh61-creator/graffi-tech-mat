++"""
++Graffi Runtime Telemetry (Omega-INFINITY)
++-----------------------------------------
++Lightweight analytics for helper operations:
++ - patch apply stats
++ - update attempts
++ - error frequency mapping
++"""
++
++import os, json, time
++
++LOG_PATH = "graffi_telemetry.log"
++
++def log(event_type, meta=None):
++    entry = {
++        "time": time.time(),
++        "event": event_type,
++        "meta": meta or {}
++    }
++    with open(LOG_PATH, "a") as f:
++        f.write(json.dumps(entry) + "\n")
++
++def stats():
++    if not os.path.exists(LOG_PATH):
++        return {"events": 0}
++
++    events = []
++    with open(LOG_PATH) as f:
++        for line in f:
++            try:
++                events.append(json.loads(line))
++            except:
++                pass
++
++    return {
++        "events": len(events),
++        "by_type": {
++            k: sum(1 for e in events if e["event"] == k)
++            for k in set(e["event"] for e in events)
++        }
++    }
++
++if __name__ == "__main__":
++    print(json.dumps(stats(), indent=4))
+
