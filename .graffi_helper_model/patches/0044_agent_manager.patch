+"""
+Dynamic Agent Manager:
+- register agents (callables)
+- schedule/run agents in-process
+- simple sandboxing via subprocess for heavy tasks
+"""
+import importlib
+import inspect
+import os
+import subprocess
+import sys
+import json
+from typing import Callable, Dict, Any
+from concurrent.futures import ThreadPoolExecutor, as_completed
+
+AGENTS: Dict[str, Callable[..., Any]] = {}
+_executor = ThreadPoolExecutor(max_workers=4)
+
+def register(name: str):
+    def deco(fn: Callable[..., Any]):
+        AGENTS[name] = fn
+        return fn
+    return deco
+
+def list_agents():
+    return list(AGENTS.keys())
+
+def run_agent(name: str, *args, sandbox: bool = False, timeout: int = 60, **kwargs):
+    if name not in AGENTS:
+        raise KeyError("unknown agent")
+    fn = AGENTS[name]
+    if sandbox:
+        # run in a separate python process with limited env
+        modpath = fn.__module__
+        qual = f"{modpath}:{fn.__name__}"
+        # we pass args via json to stdin
+        payload = {"args": args, "kwargs": kwargs}
+        p = subprocess.Popen([sys.executable, "-u", "-c",
+                              "import sys,json,importlib; m=importlib.import_module(sys.argv[1]); mod=m; "
+                              "name=sys.argv[2]; fn=getattr(mod,name); p=json.load(sys.stdin); "
+                              "res=fn(*p['args'], **p['kwargs']); print(json.dumps({'result':res}))",
+                              modpath, fn.__name__],
+                             stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                             env={"PYTHONNOUSERSITE": "1"})
+        out, err = p.communicate(input=json.dumps(payload).encode(), timeout=timeout)
+        if p.returncode != 0:
+            raise RuntimeError(f"agent sandbox failed: {err.decode()}")
+        return json.loads(out.decode())["result"]
+    else:
+        return fn(*args, **kwargs)
+
+def run_agents_parallel(agent_names, *args, **kwargs):
+    futures = []
+    for n in agent_names:
+        futures.append(_executor.submit(run_agent, n, *args, **kwargs))
+    results = {}
+    for future in as_completed(futures):
+        try:
+            res = future.result()
+            results[len(results)] = {"ok": True, "res": res}
+        except Exception as e:
+            results[len(results)] = {"ok": False, "error": str(e)}
+    return results
+
+# Example agents
+@register("echo")
+def agent_echo(message: str):
+    return {"echo": message}
+
+@register("sum")
+def agent_sum(a: int, b: int):
+    return a + b
+
+if __name__ == "__main__":
+    print("agents:", list_agents())
+    print("run echo:", run_agent("echo", "hello"))
+    print("run sum sandbox:", run_agent("sum", 2, 3, sandbox=True))

