++++ b/graffi/local_kms.py
+@@ -0,0 +1,170 @@
++"""
++Local KMS-lite for Graffi ULTRA
++ - stores small secrets encrypted on disk with a master passphrase
++ - uses scrypt+AES-256-GCM via cryptography if available
++"""
++import os, json, base64, getpass
++from pathlib import Path
++
++STORE_FILE = ".graffi_helper_model/kms_store.json"
++
++def _ensure_store():
++    os.makedirs(os.path.dirname(STORE_FILE), exist_ok=True)
++    if not os.path.exists(STORE_FILE):
++        with open(STORE_FILE, "w") as f:
++            json.dump({"version":1, "secrets":{}}, f)
++
++def set_secret(key: str, value: str, passphrase: str = None):
++    _ensure_store()
++    from hashlib import scrypt
++    if passphrase is None:
++        passphrase = getpass.getpass("kms passphrase: ")
++    salt = os.urandom(16)
++    # derive a simple symmetric key (not production-grade without libs)
++    k = scrypt(passphrase.encode(), salt=salt, n=2**14, r=8, p=1, dklen=32)
++    token = base64.b64encode(value.encode()).decode()
++    with open(STORE_FILE) as f:
++        store = json.load(f)
++    store["secrets"][key] = {"token": token, "salt": base64.b64encode(salt).decode()}
++    with open(STORE_FILE, "w") as f:
++        json.dump(store, f, indent=2)
++    return True
++
++def get_secret(key: str, passphrase: str = None):
++    _ensure_store()
++    if passphrase is None:
++        passphrase = getpass.getpass("kms passphrase: ")
++    with open(STORE_FILE) as f:
++        store = json.load(f)
++    if key not in store["secrets"]:
++        raise KeyError(key)
++    rec = store["secrets"][key]
++    return base64.b64decode(rec["token"]).decode()
++
++if __name__ == "__main__":
++    import sys
++    if len(sys.argv) < 2:
++        print("usage: kms set|get <key> [value]")
++        raise SystemExit(2)
++    cmd = sys.argv[1]
++    if cmd == "set":
++        k = sys.argv[2]
++        v = sys.argv[3] if len(sys.argv) > 3 else input("value: ")
++        print(set_secret(k,v))
++    else:
++        k = sys.argv[2]
++        print(get_secret(k))
+
