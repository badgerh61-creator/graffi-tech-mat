++"""
++Tiny local ML trainer using scikit-learn-like API implemented with numpy.
++No external dependencies required. Implements a logistic regression trainer
++for binary labels using simple gradient descent.
++"""
++import math
++import json
++import os
++from typing import List, Tuple
++import random
++
++MODEL_DIR = os.environ.get("GRAFFI_ML_DIR", "ml/models")
++os.makedirs(MODEL_DIR, exist_ok=True)
++
++def sigmoid(x):
++    return 1.0 / (1.0 + math.exp(-x))
++
++class SimpleLogistic:
++    def __init__(self, dim: int, lr: float = 0.1):
++        self.w = [0.0] * dim
++        self.b = 0.0
++        self.lr = lr
++
++    def predict_proba(self, x: List[float]) -> float:
++        z = sum([a*b for a,b in zip(self.w, x)]) + self.b
++        return sigmoid(z)
++
++    def predict(self, x: List[float]) -> int:
++        return 1 if self.predict_proba(x) >= 0.5 else 0
++
++    def step(self, x: List[float], y: int):
++        p = self.predict_proba(x)
++        err = p - y
++        for i in range(len(self.w)):
++            self.w[i] -= self.lr * err * x[i]
++        self.b -= self.lr * err
++
++    def save(self, name: str):
++        path = os.path.join(MODEL_DIR, name + ".json")
++        with open(path, "w") as f:
++            json.dump({"w": self.w, "b": self.b, "lr": self.lr}, f)
++        return path
++
++    @staticmethod
++    def load(name: str):
++        path = os.path.join(MODEL_DIR, name + ".json")
++        with open(path, "r") as f:
++            d = json.load(f)
++        m = SimpleLogistic(len(d["w"]), lr=d.get("lr", 0.1))
++        m.w = d["w"]
++        m.b = d["b"]
++        return m
++
++def build_training_matrix(features: List[dict]) -> Tuple[List[List[float]], List[int]]:
++    X = []
++    y = []
++    for rec in features:
++        feats = rec.get("features", {})
++        # deterministic order: hour, len_payload, has_user
++        X.append([feats.get("hour",0), feats.get("len_payload",0), feats.get("has_user",0)])
++        # create label heuristic: has_user -> 1 else 0
++        y.append(1 if feats.get("has_user",0) else 0)
++    return X, y
++
++def train_from_feature_file(json_path: str, model_name: str, epochs: int = 50, lr: float = 0.01):
++    import json as _json
++    with open(json_path, "r") as f:
++        data = _json.load(f)
++    X, y = build_training_matrix(data)
++    if not X:
++        raise ValueError("no training data")
++    model = SimpleLogistic(len(X[0]), lr=lr)
++    for epoch in range(epochs):
++        # simple SGD
++        idxs = list(range(len(X)))
++        random.shuffle(idxs)
++        for i in idxs:
++            model.step(X[i], y[i])
++    path = model.save(model_name)
++    return path
++
++def evaluate_model(model: SimpleLogistic, X: List[List[float]], y: List[int]):
++    correct = 0
++    for xi, yi in zip(X, y):
++        if model.predict(xi) == yi:
++            correct += 1
++    return {"accuracy": correct/len(y)}
++
++if __name__ == "__main__":
++    # quick demo: random small dataset
++    demo = [{"features":{"hour":i%24,"len_payload":i*2,"has_user": i%2}} for i in range(100)]
++    path = os.path.join("ml", "demo_features.json")
++    os.makedirs("ml", exist_ok=True)
++    import json as _json
++    with open(path, "w") as f:
++        _json.dump(demo, f)
++    p = train_from_feature_file(path, "demo_model", epochs=20, lr=0.05)
++    print("saved model to", p)
