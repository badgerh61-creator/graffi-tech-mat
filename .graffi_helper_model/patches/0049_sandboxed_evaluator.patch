+"""
+Sandboxed evaluator for patches:
+- applies patch to a temporary git index (in a temp dir)
+- runs a user-provided test function (callable path) inside a subprocess
+Requires: local git binary available (used only for sandboxing)
+"""
+import tempfile
+import os
+import shutil
+import subprocess
+import sys
+import json
+from typing import Callable, Optional
+
+def apply_patch_to_temp_repo(patch_path: str, repo_src: str) -> str:
+    """
+    Create a temp copy of repo_src, apply patch_path there. Returns path to temp repo.
+    """
+    if not os.path.exists(patch_path):
+        raise FileNotFoundError("patch not found")
+    tmp = tempfile.mkdtemp(prefix="graffi_sandbox_")
+    shutil.copytree(repo_src, os.path.join(tmp, "repo"), dirs_exist_ok=True)
+    repo_path = os.path.join(tmp, "repo")
+    # apply patch via git apply
+    cmd = ["git", "apply", "--whitespace=fix", patch_path]
+    proc = subprocess.run(cmd, cwd=repo_path, capture_output=True, text=True)
+    if proc.returncode != 0:
+        shutil.rmtree(tmp)
+        raise RuntimeError(f"git apply failed: {proc.stderr}")
+    return repo_path
+
+def run_test_in_sandbox(repo_path: str, test_cmd: str, timeout: int = 10) -> dict:
+    """
+    test_cmd: shell command to run in the sandbox repo (e.g., 'pytest -q').
+    Returns dict with returncode, stdout, stderr.
+    """
+    proc = subprocess.run(test_cmd, cwd=repo_path, shell=True, capture_output=True, text=True, timeout=timeout)
+    return {"returncode": proc.returncode, "stdout": proc.stdout, "stderr": proc.stderr}
+
+def evaluate_patch(patch_path: str, repo_src: str, test_cmd: str) -> dict:
+    repo = None
+    try:
+        repo = apply_patch_to_temp_repo(patch_path, repo_src)
+        res = run_test_in_sandbox(repo, test_cmd)
+        return res
+    finally:
+        if repo and os.path.exists(os.path.dirname(repo)):
+            shutil.rmtree(os.path.dirname(repo))
+
+if __name__ == "__main__":
+    # Basic smoke demonstration: create a temp repo with one file and try a patch
+    import textwrap
+    repo_src = tempfile.mkdtemp(prefix="demo_repo_")
+    with open(os.path.join(repo_src, "demo.txt"), "w") as f:
+        f.write("hello\n")
+    subprocess.run(["git", "init"], cwd=repo_src, capture_output=True)
+    subprocess.run(["git", "add", "."], cwd=repo_src, capture_output=True)
+    subprocess.run(["git", "commit", "-m", "init"], cwd=repo_src, capture_output=True)
+    # create a patch that changes demo.txt
+    patch = os.path.join(tempfile.gettempdir(), "demo.patch")
+    with open(patch, "w") as f:
+        f.write(textwrap.dedent("""\
+            diff --git a/demo.txt b/demo.txt
+            index e69de29..0000000 100644
+            --- a/demo.txt
+            +++ b/demo.txt
+            @@ -1 +1 @@
+            -hello
+            +hello world
+        """))
+    res = evaluate_patch(patch, repo_src, "bash -lc 'grep \"world\" demo.txt && echo OK || echo FAIL'")
+    print(res)
+    shutil.rmtree(repo_src)

