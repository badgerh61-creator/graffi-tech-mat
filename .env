ENV=development
DATABASE_URL=sqlite:///./graffi.db

SECRET_KEY=${SECRET_KEY:?SET_A_SECURE_VALUE}

AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID:?SET_SECURE_VALUE}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY:?SET_SECURE_VALUE}
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=graffi-assets

CELERY_BROKER_URL=redis://redis:6379/0
CORS_ORIGINS=["*"]

THUMBNAIL_SIZE=256
