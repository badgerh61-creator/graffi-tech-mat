++"""
++Lightweight analytics pipeline:
++- ingest simple events (in-memory)
++- feature extraction
++- write features to local feature store (sqlite)
++"""
++import sqlite3
++import json
++import os
++from typing import Dict, Iterable, List
++from datetime import datetime
++
++DB_PATH = os.environ.get("GRAFFI_FEATURE_DB", "analytics/features.db")
++
++def ensure_db():
++    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
++    con = sqlite3.connect(DB_PATH)
++    cur = con.cursor()
++    cur.execute("""
++    CREATE TABLE IF NOT EXISTS features (
++        id INTEGER PRIMARY KEY AUTOINCREMENT,
++        event_id TEXT,
++        source TEXT,
++        feature_blob TEXT,
++        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
++    )
++    """)
++    con.commit()
++    con.close()
++
++def extract_basic_features(event: Dict) -> Dict:
++    # small deterministic feature extractor
++    f = {}
++    f["len_payload"] = len(json.dumps(event.get("payload", {})))
++    f["has_user"] = 1 if event.get("user_id") else 0
++    f["source"] = event.get("source", "unknown")
++    f["hour"] = datetime.utcfromtimestamp(event.get("ts", datetime.utcnow().timestamp())).hour
++    return f
++
++def ingest_events(events: Iterable[Dict]) -> int:
++    ensure_db()
++    con = sqlite3.connect(DB_PATH)
++    cur = con.cursor()
++    count = 0
++    for e in events:
++        feats = extract_basic_features(e)
++        cur.execute("INSERT INTO features (event_id, source, feature_blob) VALUES (?, ?, ?)",
++                    (e.get("id"), e.get("source"), json.dumps(feats)))
++        count += 1
++    con.commit()
++    con.close()
++    return count
++
++def read_features(limit: int = 100) -> List[Dict]:
++    ensure_db()
++    con = sqlite3.connect(DB_PATH)
++    cur = con.cursor()
++    cur.execute("SELECT id, event_id, source, feature_blob, created_at FROM features ORDER BY id DESC LIMIT ?",
++                (limit,))
++    rows = cur.fetchall()
++    con.close()
++    out = []
++    for r in rows:
++        out.append({
++            "id": r[0],
++            "event_id": r[1],
++            "source": r[2],
++            "features": json.loads(r[3]),
++            "created_at": r[4]
++        })
++    return out
++
++if __name__ == "__main__":
++    # basic smoke test
++    sample = [
++        {"id": "e1", "user_id": "u1", "payload": {"a":1}, "ts": datetime.utcnow().timestamp()},
++        {"id": "e2", "payload": {"b":2}, "source": "sensor"}
++    ]
++    print("ingested:", ingest_events(sample))
++    print("features:", read_features(10))
+
