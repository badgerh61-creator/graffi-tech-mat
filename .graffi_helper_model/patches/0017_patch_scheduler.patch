diff --git a/scripts/patch_scheduler.sh b/scripts/patch_scheduler.sh
new file mode 100755
--- /dev/null
+++ b/scripts/patch_scheduler.sh
@@ -0,0 +1,140 @@
+#!/bin/bash
+#
+# Lightweight patch scheduler: run auto-rebuilder nightly (or on demand)
+#
+WORKDIR="$(pwd)"
+LOG="$WORKDIR/.graffi_helper_model/scheduler.log"
+AI_REBUILDER="python3 graffi/ai_rebuilder.py"
+
+usage(){
+  echo "usage: patch_scheduler.sh [now|start|run-once]"
+}
+
+run_once(){
+  echo "Scheduler run at $(date)" >> "$LOG"
+  $AI_REBUILDER --dry >> "$LOG" 2>&1
+  if [ $? -eq 0 ]; then
+    echo "Dry-run OK; applying patches" >> "$LOG"
+    $AI_REBUILDER --apply >> "$LOG" 2>&1
+  else
+    echo "Dry-run failed" >> "$LOG"
+  fi
+}
+
+case "$1" in
+  now|run-once)
+    run_once
+    ;;
+  start)
+    # run in background every 24h
+    while true; do
+      run_once
+      sleep 86400
+    done &
+    echo "Scheduler started in background"
+    ;;
+  *)
+    usage
+    ;;
+esac

