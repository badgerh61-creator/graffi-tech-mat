diff --git a/sandbox_patch.sh b/sandbox_patch.sh
new file mode 100755
--- /dev/null
+++ b/sandbox_patch.sh
@@ -0,0 +1,70 @@
+#!/bin/bash
+echo "=== Graffi Sandbox Patch Engine (DRY RUN MODE) ==="
+
+PATCH_DIR=".graffi_helper_model/patches"
+TMP_DIR=".graffi_sandbox"
+
+rm -rf $TMP_DIR
+mkdir -p $TMP_DIR
+
+echo "Copying repo into sandbox..."
+cp -r * $TMP_DIR/
+
+cd $TMP_DIR
+
+for PATCH in ../$PATCH_DIR/*.patch; do
+    echo "Testing $PATCH in sandbox..."
+    if git apply --check "$PATCH"; then
+        echo "✔ Patch valid"
+    else
+        echo "❌ Patch failed in sandbox"
+        exit 1
+    fi
+done
+
+echo "✔ All patches validated in sandbox."
+exit 0

