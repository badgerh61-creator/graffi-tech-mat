++"""
++Canary rollout manager:
++- register patch candidates
++- run sandboxed tests
++- gradually increase traffic percentage (simulated) and record success/fail
++This is a local orchestrator: no external orchestration required.
++"""
++import time
++import json
++import os
++from typing import List, Dict
++from tools.sandbox_eval import evaluate_patch
++from analytics.metrics import inc, flush
++
++CANARY_DB = os.environ.get("GRAFFI_CANARY_DB", "patches/canary.json")
++os.makedirs(os.path.dirname(CANARY_DB), exist_ok=True)
++
++def register_candidate(patch_path: str, test_cmd: str):
++    rec = {"patch": patch_path, "test_cmd": test_cmd, "registered_at": time.time()}
++    with open(CANARY_DB, "w") as f:
++        json.dump(rec, f)
++    return rec
++
++def run_canary(patch_path: str, repo_src: str, test_cmd: str, steps: int = 5, step_delay: float = 1.0):
++    results = []
++    for pct in range(1, steps+1):
++        # apply and test in sandbox
++        try:
++            res = evaluate_patch(patch_path, repo_src, test_cmd)
++            ok = res.get("returncode", 1) == 0
++        except Exception as e:
++            res = {"error": str(e)}
++            ok = False
++        results.append({"step": pct, "ok": ok, "res": res})
++        inc("canary.step", pct)
++        time.sleep(step_delay)
++        # if a failure occurs, abort and mark rollback
++        if not ok:
++            results.append({"rollback": True, "failed_at": pct})
++            with open(CANARY_DB, "w") as f:
++                json.dump({"results": results}, f, indent=2)
++            return results
++    with open(CANARY_DB, "w") as f:
++        json.dump({"results": results}, f, indent=2)
++    flush()
++    return results
++
++if __name__ == "__main__":
++    print("registering demo:", register_candidate("/tmp/demo.patch", "bash -lc 'true'"))
+
