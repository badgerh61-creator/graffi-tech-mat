diff --git a/deploy/signing_server_nginx.conf b/deploy/signing_server_nginx.conf
new file mode 100644
--- /dev/null
+++ b/deploy/signing_server_nginx.conf
@@ -0,0 +1,80 @@
+# Example nginx config to proxy the signing server (replace server_name, cert paths)
+server {
+    listen 80;
+    server_name signing.example.com;
+    return 301 https://$host$request_uri;
+}
+server {
+    listen 443 ssl;
+    server_name signing.example.com;
+    ssl_certificate /etc/ssl/certs/signing.pem;
+    ssl_certificate_key /etc/ssl/private/signing.key;
+
+    location / {
+        proxy_pass http://127.0.0.1:8000;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+    }
+}
+
diff --git a/deploy/signing_server.service b/deploy/signing_server.service
new file mode 100644
--- /dev/null
+++ b/deploy/signing_server.service
@@ -0,0 +1,70 @@
+[Unit]
+Description=Graffi Signing Server
+After=network.target
+
+[Service]
+Type=simple
+User=www-data
+WorkingDirectory=/opt/graffi/signing_server
+ExecStart=/usr/bin/env uvicorn signing_server.app:app --host 127.0.0.1 --port 8000
+Restart=on-failure
+
+[Install]
+WantedBy=multi-user.target

