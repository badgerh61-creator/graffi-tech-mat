+"""
+Graffi-Tech-Mat Updater Module (Omega-INFINITY Edition)
+-------------------------------------------------------
+Handles safe, atomic self-updates with rollback protection.
+"""
+
+import os, shutil, hashlib, tempfile
+
+class GraffiUpdater:
+    def __init__(self, target_path="graffi_helper.py"):
+        self.target = target_path
+
+    def checksum(self, path):
+        h = hashlib.sha256()
+        with open(path, "rb") as f:
+            for block in iter(lambda: f.read(4096), b""):
+                h.update(block)
+        return h.hexdigest()
+
+    def safe_replace(self, new_file):
+        backup = self.target + ".backup"
+        shutil.copy2(self.target, backup)
+
+        try:
+            shutil.copy2(new_file, self.target)
+            return True
+        except Exception:
+            shutil.copy2(backup, self.target)
+            return False
+
+def apply_update(new_file):
+    updater = GraffiUpdater()
+    return updater.safe_replace(new_file)

