diff --git a/scripts/hardened_apply.sh b/scripts/hardened_apply.sh
new file mode 100755
--- /dev/null
+++ b/scripts/hardened_apply.sh
@@ -0,0 +1,160 @@
+#!/bin/bash
+PATCH_DIR=".graffi_helper_model/patches"
+MANIFEST_PY="python3 .graffi_helper_model/patch_manifest.py"
+SIGNER_PY="python3 graffi/patch_signer.py"
+QCHK_PY="python3 graffi/quantum_checksum.py"
+
+echo "Hardened patch apply engine"
+for p in "$PATCH_DIR"/*.patch; do
+  [ -e "$p" ] || continue
+  echo "--- $p"
+  echo " Verifying signature..."
+  $SIGNER_PY verify "$p"
+  if [ $? -ne 0 ]; then
+    echo " Signature verification failed. Aborting."
+    exit 2
+  fi
+  echo " Computing quantum checksum..."
+  $QCHK_PY "$p" >/dev/null 2>&1
+  echo " Applying patch..."
+  git apply "$p"
+  if [ $? -ne 0 ]; then
+    echo " Apply failed. Aborting."
+    exit 3
+  fi
+done
+
+echo "Updating manifest..."
+$MANIFEST_PY
+echo "All patches applied and registered."

