+#!/usr/bin/env python3
+"""
+Initialize signing_server DB and optionally create a default API key.
+"""
+import sqlite3, os, hashlib, time, sys
+DB_FILE = "signing_server.db"
+
+def ensure_db():
+    conn = sqlite3.connect(DB_FILE)
+    c = conn.cursor()
+    c.execute("""
+    CREATE TABLE IF NOT EXISTS patches (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      name TEXT UNIQUE,
+      signature TEXT,
+      fingerprint TEXT,
+      uploaded_at INTEGER,
+      metadata TEXT,
+      uploader TEXT
+    )""")
+    c.execute("""
+    CREATE TABLE IF NOT EXISTS api_keys (
+      key TEXT PRIMARY KEY,
+      owner TEXT,
+      created_at INTEGER
+    )""")
+    conn.commit()
+    conn.close()
+
+def create_key(owner="local-admin"):
+    k = hashlib.sha256(f"{owner}:{time.time()}".encode()).hexdigest()
+    conn = sqlite3.connect(DB_FILE)
+    c = conn.cursor()
+    c.execute("INSERT OR IGNORE INTO api_keys (key, owner, created_at) VALUES (?,?,?)", (k, owner, int(time.time())))
+    conn.commit()
+    conn.close()
+    print(k)
+
+if __name__ == "__main__":
+    ensure_db()
+    if len(sys.argv) > 1:
+        create_key(sys.argv[1])
+    else:
+        print("Usage: init_db.py <owner_name>  -> prints created API key")

