diff --git a/scripts/publish_patch.sh b/scripts/publish_patch.sh
new file mode 100755
--- /dev/null
+++ b/scripts/publish_patch.sh
@@ -0,0 +1,120 @@
+#!/bin/bash
+set -euo pipefail
+PATCH="$1"
+SERVER="${2:-http://localhost:8000}"
+API_KEY="${3:-}"
+
+if [ -z "$PATCH" ]; then
+  echo "Usage: publish_patch.sh <patch-file> [server] [api-key]"
+  exit 2
+fi
+
+if [ -z "$API_KEY" ]; then
+  echo "API key missing; create one with signing_server/init_db.py ownername"
+  exit 2
+fi
+
+if [ ! -f "$PATCH" ]; then
+  echo "Patch not found: $PATCH"
+  exit 2
+fi
+
+# ensure signature exists
+if [ -f "${PATCH}.sig" ]; then
+  SIG="${PATCH}.sig"
+else
+  echo "No .sig found for $PATCH. Publishing anyway without signature."
+  SIG=""
+fi
+
+python3 graffi/remote_signer_client.py publish --server "$SERVER" --api-key "$API_KEY" --patch "$PATCH" --sig "$SIG"
+echo "Published $PATCH to $SERVER"

