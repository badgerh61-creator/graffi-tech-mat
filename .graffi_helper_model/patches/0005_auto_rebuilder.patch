 #!/bin/bash
 echo "=== Auto-Rebuilder Engine (Omega-INFINITY) ==="
+
+PATCH_DIR=".graffi_helper_model/patches"
+
+checksum() {
+    sha256sum "$1" | awk '{print $1}'
+}
+
+apply_all() {
+    for P in $PATCH_DIR/*.patch; do
+        echo "Applying $P..."
+        git apply --check "$P" || {
+            echo "❌ Failed integrity check"
+            exit 1
+        }
+        git apply "$P"
+    done
+}
+
+echo "Running safety validation..."
+apply_all
+
+echo "✔ Auto rebuild complete."

