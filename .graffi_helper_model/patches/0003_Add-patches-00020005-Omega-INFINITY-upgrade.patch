++#!/usr/bin/env python3
++"""
++Lightweight remote verification client for patch signatures & manifests.
++Used by the patch-apply engine to query signing servers and validate patches.
++"""
++import json
++import hashlib
++import urllib.request
++from typing import Dict
++
++DEFAULT_SIGNER = "https://signer.example.com"
++
++def fetch_manifest(url: str) -> Dict:
++    with urllib.request.urlopen(url, timeout=10) as r:
++        return json.load(r)
++
++def sha256_bytes(data: bytes) -> str:
++    return hashlib.sha256(data).hexdigest()
++
++def verify_manifest(manifest: Dict, expected_root: str) -> bool:
++    # simple root hash vs manifest["root_hash"]
++    return manifest.get("root_hash") == expected_root
++
++if __name__ == "__main__":
++    import sys
++    if len(sys.argv) < 3:
++        print("usage: remote_verifier.py <manifest_url> <expected_root>")
++        raise SystemExit(2)
++    m = fetch_manifest(sys.argv[1])
++    ok = verify_manifest(m, sys.argv[2])
++    print("OK" if ok else "FAILED")
+
