diff --git a/apply_patch_series.sh b/apply_patch_series.sh
index 1111111..3333333 100755
--- a/apply_patch_series.sh
+++ b/apply_patch_series.sh
@@ -1,5 +1,52 @@
 #!/bin/bash
 echo "=== Graffi Patch Apply Engine (Omega-INFINITY) ==="
+
+PATCH_DIR=".graffi_helper_model/patches"
+
+for PATCH in $PATCH_DIR/*.patch; do
+    echo "Testing $PATCH..."
+    if git apply --check "$PATCH"; then
+        echo "✔ Applying $PATCH"
+        git apply "$PATCH"
+    else
+        echo "❌ Patch failed: $PATCH"
+        exit 1
+    fi
+done
+
+echo "✔ All patches applied."

