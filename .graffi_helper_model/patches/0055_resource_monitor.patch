+"""
+Minimal resource monitor (no psutil dependency):
+- reports memory and CPU using /proc (Linux-specific)
+"""
+import os
+import time
+from typing import Dict
+
+def read_proc_stat() -> Dict:
+    # read uptime as a proxy
+    stat = {}
+    try:
+        with open("/proc/uptime", "r") as f:
+            uptime = float(f.readline().split()[0])
+        stat["uptime"] = uptime
+    except Exception:
+        stat["uptime"] = None
+    try:
+        with open("/proc/meminfo", "r") as f:
+            lines = f.readlines()
+        mem = {}
+        for l in lines:
+            k, v = l.split(":",1)
+            mem[k.strip()] = v.strip()
+        stat["meminfo"] = mem
+    except Exception:
+        stat["meminfo"] = {}
+    return stat
+
+def snapshot():
+    return read_proc_stat()
+
+if __name__ == "__main__":
+    import json
+    print(json.dumps(snapshot(), indent=2)[:1000])

