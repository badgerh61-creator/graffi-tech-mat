++"""
++Graffi Self-Healing Engine (Omega-INFINITY)
++-------------------------------------------
++Detects failed patches or corrupted updates and restores stability.
++"""
++
++import os, shutil, hashlib
++
++BACKUP_DIR = ".graffi_backups"
++os.makedirs(BACKUP_DIR, exist_ok=True)
++
++CRITICAL_FILES = [
++    "graffi_helper.py",
++    "graffi/updater.py",
++    "auto_rebuilder.sh",
++    "apply_patch_series.sh"
++]
++
++def sha256(file):
++    h = hashlib.sha256()
++    with open(file, "rb") as f:
++        for block in iter(lambda: f.read(4096), b""):
++            h.update(block)
++    return h.hexdigest()
++
++def backup():
++    for f in CRITICAL_FILES:
++        if os.path.exists(f):
++            shutil.copy2(f, os.path.join(BACKUP_DIR, os.path.basename(f)))
++
++def restore():
++    for f in CRITICAL_FILES:
++        backup_file = os.path.join(BACKUP_DIR, os.path.basename(f))
++        if os.path.exists(backup_file):
++            shutil.copy2(backup_file, f)
++
++def verify():
++    for f in CRITICAL_FILES:
++        if not os.path.exists(f):
++            return False
++    return True
++
++if __name__ == "__main__":
++    print("Self-heal verify:", verify())
+
