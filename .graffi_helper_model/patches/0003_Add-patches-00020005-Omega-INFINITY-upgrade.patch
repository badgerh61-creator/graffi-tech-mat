@@ -0,0 +1,130 @@
+diff --git a/graffi/ai_rebuilder.py b/graffi/ai_rebuilder.py
+index 0000000..0000000
+--- a/graffi/ai_rebuilder.py
++++ b/graffi/ai_rebuilder.py
+@@ -1,200 +1,260 @@
+ # (This patch augments the existing ai_rebuilder to consult a remote signing server)
+@@ -0,0 +1,200 @@
++"""
++Graffi AI-Autonomous Rebuilder (with optional remote verification)
++— extends previous ai_rebuilder to call a signing server to confirm patch fingerprint/signature.
++"""
++from __future__ import annotations
++import os, json, subprocess, time, shutil
++from typing import List
++import requests
++
++PATCH_DIR = ".graffi_helper_model/patches"
++CHECKPOINT_FILE = ".graffi_helper_model/ai_rebuilder_checkpoint.json"
++SANDBOX_SCRIPT = "sandbox_patch.sh"
++SIGNING_SERVER = os.environ.get("GRAFFI_SIGNING_SERVER", "")
++SIGNING_SERVER_APIKEY = os.environ.get("GRAFFI_SIGNING_APIKEY", "")
++
++def list_patches() -> List[str]:
++    if not os.path.isdir(PATCH_DIR):
++        return []
++    return sorted(p for p in os.listdir(PATCH_DIR) if p.endswith(".patch"))
++
++def run_cmd(cmd, cwd=None, timeout=300):
++    proc = subprocess.run(cmd, shell=True, cwd=cwd, capture_output=True, text=True, timeout=timeout)
++    return proc.returncode, proc.stdout, proc.stderr
++
++def compute_fingerprint(path):
++    import hashlib
++    h = hashlib.sha3_512()
++    with open(path, "rb") as f:
++        for chunk in iter(lambda: f.read(4096), b""):
++            h.update(chunk)
++    return h.hexdigest()
++
++def remote_verify(patch_filename: str, patch_path: str) -> bool:
++    # If no signing server configured, default to local verification only
++    if not SIGNING_SERVER:
++        return True
++    try:
++        url = SIGNING_SERVER.rstrip("/") + "/api/v1/patches/" + patch_filename
++        r = requests.get(url, timeout=10)
++        if r.status_code != 200:
++            return False
++        rec = r.json()
++        remote_fp = rec.get("fingerprint")
++        local_fp = compute_fingerprint(patch_path)
++        return remote_fp == local_fp
++    except Exception:
++        return False
++
++def sandbox_validate(patch_files: List[str]) -> bool:
++    # Use sandbox_patch.sh if present, otherwise run git apply --check per patch
++    if os.path.exists(SANDBOX_SCRIPT) and os.access(SANDBOX_SCRIPT, os.X_OK):
++        code, out, err = run_cmd(f"./{SANDBOX_SCRIPT}")
++        return code == 0
++
++    for p in patch_files:
++        code, out, err = run_cmd(f"git apply --check {os.path.join(PATCH_DIR,p)}")
++        if code != 0:
++            return False
++    return True
++
++def checkpoint_save(state: dict):
++    os.makedirs(os.path.dirname(CHECKPOINT_FILE), exist_ok=True)
++    with open(CHECKPOINT_FILE, "w") as f:
++        json.dump(state, f, indent=2)
++
++def checkpoint_load() -> dict:
++    if not os.path.exists(CHECKPOINT_FILE):
++        return {}
++    with open(CHECKPOINT_FILE) as f:
++        return json.load(f)
++
++def apply_patch_file(patch_file: str) -> bool:
++    code, out, err = run_cmd(f"git apply {patch_file}")
++    return code == 0
++
++def rebuild(auto_confirm: bool = True) -> dict:
++    patches = list_patches()
++    state = checkpoint_load()
++    applied = state.get("applied", [])
++
++    remaining = [p for p in patches if p not in applied]
++    if not remaining:
++        return {"status": "noop", "message": "No remaining patches"}
++
++    # remote verification: ensure remote fingerprint matches local
++    for p in remaining:
++        path = os.path.join(PATCH_DIR, p)
++        if not remote_verify(p, path):
++            return {"status": "failed", "message": f"Remote verification failed for {p}"}
++
++    if not sandbox_validate(remaining):
++        return {"status": "failed", "message": "Sandbox validation failed"}
++
++    for p in remaining:
++        patch_path = os.path.join(PATCH_DIR, p)
++        # create backup checkpoint
++        checkpoint_save({"applied": applied, "current": p, "time": time.time()})
++        ok = apply_patch_file(patch_path)
++        if not ok:
++            # restore to last checkpoint by aborting (user can run self_heal)
++            return {"status": "partial", "message": f"Failed applying {p}", "applied": applied}
++        applied.append(p)
++        checkpoint_save({"applied": applied, "time": time.time()})
++
++    return {"status": "ok", "applied": applied}
++
++if __name__ == "__main__":
++    import argparse
++    p = argparse.ArgumentParser()
++    p.add_argument("--dry", action="store_true", help="Do a sandbox dry run")
++    p.add_argument("--apply", action="store_true", help="Run the rebuild and apply patches")
++    args = p.parse_args()
++
++    if args.dry:
++        patches = list_patches()
++        ok = sandbox_validate(patches)
++        print("Dry run result:", ok)
++    elif args.apply:
++        res = rebuild()
++        print(json.dumps(res, indent=2))
++    else:
++        print("Use --dry or --apply")
+
