+@@ -0,0 +1,160 @@
++#!/usr/bin/env python3
++"""
++Minimal admin tool to list/create/delete API keys (works directly on sqlite DB).
++Usage:
++  python3 admin_keys.py list
++  python3 admin_keys.py create ownername
++  python3 admin_keys.py delete <key>
++"""
++import sqlite3, sys, os, hashlib, time
++DB_FILE = "signing_server.db"
++
++def list_keys():
++    conn = sqlite3.connect(DB_FILE)
++    c = conn.cursor()
++    c.execute("SELECT key, owner, created_at FROM api_keys")
++    rows = c.fetchall()
++    conn.close()
++    for k,o,t in rows:
++        print(k, o, t)
++
++def create_key(owner):
++    k = hashlib.sha256(f"{owner}:{time.time()}".encode()).hexdigest()
++    conn = sqlite3.connect(DB_FILE)
++    c = conn.cursor()
++    c.execute("INSERT OR IGNORE INTO api_keys (key, owner, created_at) VALUES (?,?,?)", (k, owner, int(time.time())))
++    conn.commit()
++    conn.close()
++    print(k)
++
++def delete_key(key):
++    conn = sqlite3.connect(DB_FILE)
++    c = conn.cursor()
++    c.execute("DELETE FROM api_keys WHERE key=?", (key,))
++    conn.commit()
++    conn.close()
++    print("deleted")
++
++if __name__ == "__main__":
++    if len(sys.argv) < 2:
++        print("usage: admin_keys.py <list|create|delete> [args]")
++        raise SystemExit(2)
++    cmd = sys.argv[1]
++    if cmd == "list":
++        list_keys()
++    elif cmd == "create":
++        if len(sys.argv) < 3:
++            raise SystemExit("owner required")
++        create_key(sys.argv[2])
++    elif cmd == "delete":
++        if len(sys.argv) < 3:
++            raise SystemExit("key required")
++        delete_key(sys.argv[2])
++    else:
++        print("unknown cmd")
+
diff --git a/.graffi_helper_model/patches/0030_signing_server_readme.patch b/.graffi_helper_model/patches/0030_signing_server_readme.patch
