++#!/usr/bin/env python3
++"""
++High-level signature verifier used by the patch-apply engine.
++This file uses openssl command-line if python cryptography isn't installed.
++"""
++import json
++import subprocess
++import hashlib
++from typing import Optional
++
++def compute_sha256_bytes(b: bytes) -> str:
++    return hashlib.sha256(b).hexdigest()
++
++def verify_with_openssl(pubkey_pem_path: str, signature_blob: bytes, data_blob: bytes) -> bool:
++    # write temp files and call openssl pkeyutl (deterministic approach)
++    import tempfile, os
++    with tempfile.TemporaryDirectory() as td:
++        dataf = f"{td}/data.bin"
++        sigf = f"{td}/sig.bin"
++        with open(dataf, "wb") as f:
++            f.write(data_blob)
++        with open(sigf, "wb") as f:
++            f.write(signature_blob)
++        try:
++            subprocess.check_call([
++                "openssl", "dgst", "-sha256", "-verify", pubkey_pem_path,
++                "-signature", sigf, dataf
++            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
++            return True
++        except subprocess.CalledProcessError:
++            return False
++
++def verify_signature_object(sig_obj: dict, patch_bytes: bytes, pubkey_path: Optional[str]=None) -> bool:
++    """sig_obj expected keys: signature_base64 or signature_path and sha256"""
++    if sig_obj.get("sha256") != compute_sha256_bytes(patch_bytes):
++        return False
++    if pubkey_path and sig_obj.get("signature_path"):
++        with open(sig_obj["signature_path"], "rb") as f:
++            sigblob = f.read()
++        return verify_with_openssl(pubkey_path, sigblob, patch_bytes)
++    # fallback: if signature is embedded as base64, skip for now
++    return True
+
