++"""
++Metrics collector: collects counters and simple gauges in process, flushable to sqlite.
++"""
++import sqlite3
++import os
++import time
++from threading import Lock
++from typing import Dict
++
++DB_PATH = os.environ.get("GRAFFI_METRICS_DB", "analytics/metrics.db")
++_lock = Lock()
++_metrics: Dict[str, float] = {}
++
++def ensure_db():
++    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
++    con = sqlite3.connect(DB_PATH)
++    cur = con.cursor()
++    cur.execute("""
++    CREATE TABLE IF NOT EXISTS metrics (
++        id INTEGER PRIMARY KEY AUTOINCREMENT,
++        name TEXT,
++        value REAL,
++        ts TIMESTAMP DEFAULT CURRENT_TIMESTAMP
++    )
++    """)
++    con.commit()
++    con.close()
++
++def inc(name: str, delta: float = 1.0):
++    with _lock:
++        _metrics[name] = _metrics.get(name, 0.0) + delta
++
++def gauge(name: str, value: float):
++    with _lock:
++        _metrics[name] = value
++
++def flush():
++    ensure_db()
++    with _lock:
++        if not _metrics:
++            return 0
++        con = sqlite3.connect(DB_PATH)
++        cur = con.cursor()
++        for k, v in _metrics.items():
++            cur.execute("INSERT INTO metrics (name, value) VALUES (?, ?)", (k, float(v)))
++        con.commit()
++        con.close()
++        n = len(_metrics)
++        _metrics.clear()
++        return n
++
++if __name__ == "__main__":
++    inc("test.counter", 3)
++    gauge("cpu", 12.3)
++    print("flushed:", flush())
+
